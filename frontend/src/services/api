import axios from 'axios';

// Base API URL points to FastAPI backend
const API_BASE_URL = import.meta.env.VITE_API_URL || 'http://localhost:8000/api';

const apiClient = axios.create({
  baseURL: API_BASE_URL,
  headers: {
    'Content-Type': 'application/json',
  },
});

// Automatically inject JWT Bearer token into requests
apiClient.interceptors.request.use(
  (config) => {
    const token = localStorage.getItem('ecotrace_token');
    if (token) {
      config.headers.Authorization = `Bearer ${token}`;
    }
    return config;
  },
  (error) => Promise.reject(error)
);

// Intercept 401s
apiClient.interceptors.response.use(
  (response) => response,
  (error) => {
    if (error.response && error.response.status === 401) {
      // Don't auto-redirect if checking me or on public verify page
      const isPublic = window.location.pathname.startsWith('/verify/');
      if (!isPublic && window.location.pathname !== '/login') {
        // localStorage.removeItem('ecotrace_token');
        // localStorage.removeItem('ecotrace_user');
      }
    }
    return Promise.reject(error);
  }
);

export const api = {
  // Authentication
  auth: {
    login: async (email, password) => {
      const res = await apiClient.post('/auth/login', { email, password });
      return res.data;
    },
    register: async (name, email, password, role = 'USER') => {
      const res = await apiClient.post('/auth/register', { name, email, password, role });
      return res.data;
    },
    getMe: async () => {
      const res = await apiClient.get('/auth/me');
      return res.data;
    },
